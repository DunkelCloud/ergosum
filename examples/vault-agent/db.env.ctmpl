{{- /*
  PostgreSQL client settings of this machine as shell variables, from
  secret/host/<identity>/db/config      host, database
  secret/host/<identity>/db/credentials user, password
  The identity is the "host" claim of the Vault token, so the template is the
  same on every machine. Use: . /run/vault-agent/db.env && psql ...
  With machine-auth.sh -kv or -prefix other than secret and host, change
  the paths below to match.
*/ -}}
{{- with secret "auth/token/lookup-self" }}{{ $host := .Data.meta.host -}}
{{- with secret (printf "secret/data/host/%s/db/config" $host) }}
export PGHOST='{{ .Data.data.host | replaceAll "'" "'\\''" }}'
export PGDATABASE='{{ .Data.data.database | replaceAll "'" "'\\''" }}'
{{- end }}
{{- with secret (printf "secret/data/host/%s/db/credentials" $host) }}
export PGUSER='{{ .Data.data.user | replaceAll "'" "'\\''" }}'
export PGPASSWORD='{{ .Data.data.password | replaceAll "'" "'\\''" }}'
{{- end }}
{{- end }}
