{{- /*
  restic settings of this machine as shell variables, from
  secret/host/<identity>/backup/config      repository
  secret/host/<identity>/backup/credentials restic_password, access_key_id, secret_access_key
  The identity is the "host" claim of the Vault token, so the template is the
  same on every machine. Use: . /run/vault-agent/backup.env && restic backup ...
  With machine-auth.sh -kv or -prefix other than secret and host, change
  the paths below to match.
*/ -}}
{{- with secret "auth/token/lookup-self" }}{{ $host := .Data.meta.host -}}
{{- with secret (printf "secret/data/host/%s/backup/config" $host) }}
export RESTIC_REPOSITORY='{{ .Data.data.repository | replaceAll "'" "'\\''" }}'
{{- end }}
{{- with secret (printf "secret/data/host/%s/backup/credentials" $host) }}
export RESTIC_PASSWORD='{{ .Data.data.restic_password | replaceAll "'" "'\\''" }}'
export AWS_ACCESS_KEY_ID='{{ .Data.data.access_key_id | replaceAll "'" "'\\''" }}'
export AWS_SECRET_ACCESS_KEY='{{ .Data.data.secret_access_key | replaceAll "'" "'\\''" }}'
{{- end }}
{{- end }}
